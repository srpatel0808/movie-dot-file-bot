# Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Admin Telegram User IDs (comma-separated, get yours from @userinfobot or @raw_data_bot)
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Telegram Channel Username or ID where movies are posted (optional, e.g. @MyMovieChannel or -100xxxxxxxxxx)
CHANNEL_ID=

# Bot Username without @ (optional, automatically fetched from Bot API if omitted)
BOT_USERNAME=
