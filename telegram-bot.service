[Unit]
Description=Telegram Thumbnail Watermark Bot 24/7 Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Adjust this path to your bot installation folder on your server
WorkingDirectory=/root/telegram-watermark-bot
ExecStart=/usr/bin/python3 /root/telegram-watermark-bot/bot.py

# 24/7 Auto-restart settings
Restart=always
RestartSec=5s

# Standard output and error logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
